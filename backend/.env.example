# کپی این فایل به .env و مقادیر واقعی را جایگزین کنید.
# .env هرگز نباید Commit شود (در .gitignore قرار دارد).

# --- Server ---
PORT=3000

# --- Database ---
# فرمت: mysql://USER:PASSWORD@HOST:PORT/DATABASE — روی اکثر هاست‌های اشتراکی، HOST معمولاً
# "localhost" و PORT معمولاً 3306 است؛ USER/PASSWORD/DATABASE را پنل هاست (مثلاً DirectAdmin) به شما می‌دهد.
DATABASE_URL=mysql://truckaccounting:changeme@localhost:3306/truckaccounting

# --- JWT (User App: Owner/Driver) ---
# با دستور زیر یک مقدار تصادفی امن بسازید و اینجا جایگزین کنید (هرگز از مقدار نمونه استفاده نکنید):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET

# --- Admin App ---
# باید با JWT_SECRET/JWT_REFRESH_SECRET بالا متفاوت باشد — همین تفاوت است که یک توکن کاربر عادی
# را برای همیشه در برابر API‌های /admin/* بی‌اثر می‌کند (نه فقط بررسی Role، بلکه خودِ امضای JWT).
ADMIN_JWT_SECRET=REPLACE_WITH_A_THIRD_DIFFERENT_LONG_RANDOM_SECRET
ADMIN_ACCESS_TOKEN_TTL_SECONDS=28800

# کلید ۳۲ بایتی (۶۴ کاراکتر Hex) برای رمزنگاری AES-256-GCM اطلاعات حساس (API Key ملی‌پیامک/زرین‌پال)
# قبل از ذخیره در دیتابیس — با دستور زیر بسازید:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=REPLACE_WITH_A_64_CHAR_HEX_KEY

# --- Token lifetimes (seconds) ---
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
INVITATION_TTL_SECONDS=604800

# --- Rate limiting (auth endpoints only) ---
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000

# --- Optional: bootstrap the first SUPER_ADMIN automatically on startup ---
# Only needed on a platform with no shell access to run `node scripts/create-admin.ts` manually
# (e.g. a free-tier PaaS like Render). Leave all three unset if you can run that script instead.
# Safe to leave set across restarts — a no-op once that phone number already has an admin account.
#BOOTSTRAP_ADMIN_PHONE=09120000001
#BOOTSTRAP_ADMIN_PASSWORD=a-strong-password
#BOOTSTRAP_ADMIN_NAME=Your Name
